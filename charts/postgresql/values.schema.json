{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      },
      "additionalProperties": false
    },
    "imageCatalogRef": {
      "type": "object",
      "properties": {
        "apiGroup": {
          "const": "postgresql.cnpg.io"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ImageCatalog",
            "ClusterImageCatalog"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "major": {
          "type": "integer",
          "minimum": 10
        }
      },
      "additionalProperties": false,
      "if": {
        "minProperties": 1
      },
      "then": {
        "required": [
          "apiGroup",
          "kind",
          "name",
          "major"
        ]
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "enableSuperuserAccess": {
      "type": "boolean"
    },
    "initdb": {
      "type": "object"
    },
    "bootstrap": {
      "type": "object",
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "initdb": {
          "type": "object"
        },
        "recovery": {
          "type": "object"
        },
        "pg_basebackup": {
          "type": "object"
        }
      }
    },
    "externalClusters": {
      "type": "array"
    },
    "managed": {
      "type": "object"
    },
    "database": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "authMethod": {
          "type": "string",
          "enum": [
            "password",
            "certificate"
          ]
        },
        "syncWave": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^(-?[0-9]+)?$"
            }
          ]
        },
        "cluster": false,
        "extensions": {
          "type": "array"
        },
        "schemas": {
          "type": "array"
        },
        "databaseReclaimPolicy": {
          "type": "string",
          "enum": [
            "retain",
            "delete"
          ]
        },
        "ensure": {
          "type": "string",
          "enum": [
            "present",
            "absent"
          ]
        },
        "localeCType": {
          "type": "string",
          "minLength": 1
        },
        "localeCollate": {
          "type": "string",
          "minLength": 1
        },
        "enabled": false
      },
      "additionalProperties": true,
      "required": [
        "localeCType",
        "localeCollate"
      ]
    },
    "databases": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "cluster": false,
            "databaseReclaimPolicy": {
              "type": "string",
              "enum": [
                "retain",
                "delete"
              ]
            },
            "ensure": {
              "type": "string",
              "enum": [
                "present",
                "absent"
              ]
            }
          },
          "additionalProperties": true,
          "required": [
            "name",
            "owner"
          ]
        }
      },
      "additionalProperties": false
    },
    "databaseRoles": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "cluster": false,
            "ensure": {
              "type": "string",
              "enum": [
                "present"
              ]
            },
            "databaseRoleReclaimPolicy": {
              "type": "string",
              "enum": [
                "retain",
                "delete"
              ]
            }
          },
          "additionalProperties": true,
          "required": [
            "name"
          ]
        }
      },
      "additionalProperties": false
    },
    "poolers": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$": {
          "type": "object",
          "properties": {
            "cluster": false,
            "type": {
              "type": "string",
              "enum": [
                "rw",
                "ro",
                "r"
              ]
            },
            "instances": {
              "type": "integer",
              "minimum": 0
            },
            "pgbouncer": {
              "type": "object"
            },
            "template": {
              "type": "object"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "primaryUpdateStrategy": {
      "type": "string",
      "enum": [
        "unsupervised",
        "supervised"
      ]
    },
    "primaryUpdateMethod": {
      "type": "string",
      "enum": [
        "restart",
        "switchover"
      ]
    },
    "smartShutdownTimeout": {
      "type": "integer",
      "minimum": 0
    },
    "affinity": {
      "type": "object"
    },
    "storageNodesOnly": {
      "type": "boolean"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "spreadAcrossNodes": {
      "type": "boolean"
    },
    "extraClusterSpec": {
      "type": "object"
    },
    "labels": {
      "type": "object"
    },
    "annotations": {
      "type": "object"
    },
    "inheritedLabels": {
      "type": "object"
    },
    "inheritedAnnotations": {
      "type": "object"
    },
    "syncWave": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^(-?[0-9]+)?$"
        }
      ]
    },
    "databaseSyncWave": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^(-?[0-9]+)?$"
        }
      ]
    },
    "tls": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "certManager",
            "operator",
            "external"
          ]
        },
        "certificates": {
          "type": "object"
        },
        "clientCertificate": {
          "type": "boolean"
        },
        "issuerRef": {
          "type": "object"
        },
        "superuserCertificate": {
          "type": "boolean"
        },
        "serverAltDNSNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "objectBucket": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClassName": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "string",
          "enum": [
            "primary",
            "prefer-standby"
          ]
        },
        "retentionPolicy": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[dwm]$"
        },
        "configuration": {
          "type": "object"
        },
        "objectStore": {
          "type": "object",
          "properties": {
            "existingName": {
              "type": "string"
            },
            "instanceSidecarConfiguration": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "volumeSnapshot": {
          "type": "object"
        },
        "scheduled": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string",
              "pattern": "^\\S+(\\s+\\S+){5}$"
            },
            "immediate": {
              "type": "boolean"
            },
            "suspend": {
              "type": "boolean"
            },
            "backupOwnerReference": {
              "type": "string",
              "enum": [
                "none",
                "self",
                "cluster"
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "",
                "plugin",
                "volumeSnapshot"
              ]
            }
          },
          "additionalProperties": false
        },
        "serverName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "object"
        },
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "annotations": {
              "type": "object"
            },
            "podMetricsEndpoints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "replicationSlots": {
      "type": "object"
    },
    "global": {
      "type": "object"
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "existing",
            "generated",
            "copy"
          ]
        },
        "password": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": {
              "type": "integer",
              "minimum": 16
            },
            "digits": {
              "type": "integer",
              "minimum": 0
            },
            "symbols": {
              "type": "integer",
              "minimum": 0
            },
            "symbolCharacters": {
              "type": "string"
            },
            "noUpper": {
              "type": "boolean"
            },
            "allowRepeat": {
              "type": "boolean"
            }
          }
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(s|m|h)$"
            }
          }
        },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "userSecretName": {
              "type": "string"
            },
            "superuserSecretName": {
              "type": "string"
            }
          }
        },
        "existing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "userSecretName": {
              "type": "string",
              "minLength": 1
            },
            "superuserSecretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "instances": {
      "type": "integer",
      "minimum": 1
    },
    "postgresql": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "affinity",
    "topologySpreadConstraints"
  ]
}
