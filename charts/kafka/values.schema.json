{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 40
    },
    "syncWave": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^(-?[0-9]+)?$"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "kafka": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)?$"
        },
        "metadataVersion": {
          "type": "string",
          "pattern": "^([0-9]+\\.[0-9]+-IV[0-9]+)?$"
        },
        "clientPeers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "config": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "nodePools": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 20
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "broker",
                "controller"
              ]
            }
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "storage": {
            "type": "object",
            "properties": {
              "size": {
                "type": "string",
                "pattern": "^[0-9]+(Mi|Gi|Ti)$"
              },
              "class": {
                "type": "string"
              }
            },
            "required": [
              "size"
            ],
            "additionalProperties": false
          },
          "resources": {
            "type": "object"
          }
        },
        "required": [
          "roles",
          "replicas",
          "storage"
        ],
        "additionalProperties": false
      }
    },
    "spreadAcrossNodes": {
      "type": "boolean"
    },
    "entityOperator": {
      "type": "object",
      "properties": {
        "topicOperator": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "userOperator": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "topics": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "partitions": {
            "type": "integer",
            "minimum": 1
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "partitions"
        ],
        "additionalProperties": false
      }
    },
    "users": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 48
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "authMethod": {
            "type": "string",
            "enum": [
              "mtls",
              "password"
            ]
          },
          "plaintext": {
            "type": "boolean"
          },
          "acls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "acls"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "plaintext": {
              "const": true
            }
          },
          "required": [
            "plaintext"
          ]
        },
        "then": {
          "properties": {
            "authMethod": {
              "const": "password"
            }
          },
          "required": [
            "authMethod"
          ]
        }
      }
    },
    "podMonitors": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
